<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appIEES.Views.MainPage">

    <ContentPage.Resources>
        <!-- ESTILOS IMPLÍCITOS (sin x:Key) -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#333333" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#F2F2F7" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="PlaceholderColor" Value="Gray" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="#F2F2F7" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="BackgroundColor" Value="#F2F2F7" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#512BD4" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20">

            <Image Source="logo.png" HeightRequest="100" Aspect="AspectFit"
                   SemanticProperties.Description="Logo de la aplicación" />

            <Label Text="Tipo de identificación" />
            <Picker x:Name="TipoPicker"
                    Title="Seleccione"
                    SelectedIndexChanged="OnTipoChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>CI</x:String>
                        <x:String>RUC</x:String>
                        <x:String>Pasaporte</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Identificación" />
            <Entry x:Name="IdentificacionEntry" Placeholder="Número de identificación" />

            <Label Text="Nombres" />
            <Entry x:Name="NombresEntry" Placeholder="Nombres" />

            <Label Text="Apellidos" />
            <Entry x:Name="ApellidosEntry" Placeholder="Apellidos" />

            <Label Text="Fecha" />
            <DatePicker x:Name="FechaPicker" />

            <Label Text="Correo" />
            <Entry x:Name="CorreoEntry" Placeholder="correo@ejemplo.com" Keyboard="Email" />

            <Label Text="Salario" />
            <Entry x:Name="SalarioEntry" Placeholder="0.00" Keyboard="Numeric" />

            <Label x:Name="ErroresLabel" TextColor="Red" />

            <Button Text="Guardar y ver resumen" Clicked="OnGuardarClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
